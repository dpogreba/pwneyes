<?xml version="1.0" encoding="utf-8"?>
<!-- Home fragment: tab-based WebView viewer for all saved Pwnagotchi instances.
     When no connections are saved the empty-state card is shown; once at least
     one connection exists the pager_container fills the screen and the FAB
     floats on top. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Empty state — visible when no connections have been added yet -->
    <LinearLayout
        android:id="@+id/empty_state"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/empty_state_padding"
        android:visibility="visible">

        <ImageView
            android:layout_width="@dimen/empty_state_icon_size"
            android:layout_height="@dimen/empty_state_icon_size"
            android:alpha="0.4"
            android:contentDescription="@string/cd_bluetooth_icon"
            android:src="@drawable/ic_bluetooth"
            app:tint="@color/blue_500" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/no_connections_title"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/no_connections_message"
            android:textColor="?attr/colorOnSurface"
            android:alpha="0.6"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- Pager container — GONE when empty, fills the screen when connections exist.
         CoordinatorLayout children stack like a FrameLayout so the FAB floats
         over this LinearLayout without extra nesting. -->
    <LinearLayout
        android:id="@+id/pager_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Scrollable tabs — one per saved Pwnagotchi instance -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tab_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:tabMode="scrollable"
            app:tabGravity="start"
            app:tabIndicatorColor="?attr/colorPrimary"
            app:tabSelectedTextColor="?attr/colorPrimary"
            app:tabTextColor="?attr/colorOnSurface" />

        <!-- Each page is a ConnectionWebViewFragment -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/view_pager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    </LinearLayout>

    <!-- FAB — always visible so the user can add connections from any state -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_add"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/fab_margin"
        android:contentDescription="@string/fab_add_connection"
        android:src="@drawable/ic_add"
        app:fabSize="normal"
        style="@style/Widget.PwnEyes.FAB" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
