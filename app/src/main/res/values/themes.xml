<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.PwnEyes" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/blue_500</item>
        <item name="colorPrimaryVariant">@color/blue_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/green_500</item>
        <item name="colorSecondaryVariant">@color/green_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorAccent">@color/amber_accent</item>
        <item name="android:statusBarColor" tools:targetApi="21">?attr/colorPrimaryVariant</item>
        <item name="android:navigationBarColor" tools:targetApi="21">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
        <item name="navigationViewStyle">@style/Widget.PwnEyes.NavigationView</item>
    </style>

    <style name="Theme.PwnEyes.NoActionBar" parent="Theme.PwnEyes">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.PwnEyes.AppBarOverlay"
        parent="ThemeOverlay.MaterialComponents.Dark.ActionBar">
        <item name="android:background">@drawable/toolbar_background</item>
    </style>

    <style name="Theme.PwnEyes.PopupOverlay"
        parent="ThemeOverlay.MaterialComponents.Light" />

    <!-- Connection card status dot -->
    <style name="StatusDot">
        <item name="android:layout_width">10dp</item>
        <item name="android:layout_height">10dp</item>
    </style>

    <!-- FAB style -->
    <style name="Widget.PwnEyes.FAB" parent="Widget.MaterialComponents.FloatingActionButton">
        <item name="backgroundTint">@null</item>
        <item name="android:background">@drawable/fab_gradient</item>
        <item name="elevation">8dp</item>
        <item name="hoveredFocusedTranslationZ">4dp</item>
        <item name="pressedTranslationZ">6dp</item>
    </style>

    <!-- NavigationView style -->
    <style name="Widget.PwnEyes.NavigationView" parent="Widget.MaterialComponents.NavigationView">
        <item name="itemShapeAppearanceOverlay">@style/NavItemShapeAppearance</item>
        <item name="itemShapeFillColor">@color/nav_item_active_background</item>
        <item name="itemIconTint">@color/nav_item_icon_tint</item>
        <item name="itemTextColor">@color/nav_item_text_color</item>
    </style>

    <style name="NavItemShapeAppearance" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomRight">28dp</item>
        <item name="cornerSizeTopLeft">0dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
    </style>

</resources>
